<!-- O mascote: fica andando logo acima da barra de tarefas.
     Clique e arraste: move (ele cai de volta)  |  Duplo clique: pula e fala  |  Botão direito: menu -->
<Window x:Class="Mascote.Principal.JanelaMascote"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="170" Height="120" AllowDrop="True">
  <Canvas x:Name="Palco">
    <Canvas x:Name="CamadaConfete" IsHitTestVisible="False" Panel.ZIndex="9"/>
    <!-- balão sempre na frente do mascote, da nuvem e do guarda-chuva -->
    <Border x:Name="Balao" Canvas.Left="5" Canvas.Bottom="62" Width="160" Visibility="Collapsed" Panel.ZIndex="10"
            Background="White" BorderBrush="#5A3E0A" BorderThickness="1.5" CornerRadius="10" Padding="6,4"
            MouseLeftButtonDown="Balao_Clique">
      <TextBlock x:Name="TextoBalao" TextWrapping="Wrap" TextAlignment="Center"
                 FontFamily="Segoe UI" FontSize="12" Foreground="#333"/>
    </Border>
    <Canvas x:Name="Mascot" Background="{x:Null}" RenderTransformOrigin="0.5,1" Cursor="Hand" AllowDrop="True"
            MouseLeftButtonDown="Mascot_Clique"
            DragEnter="Mascot_DragEnter" DragOver="Mascot_DragOver" DragLeave="Mascot_DragLeave" Drop="Mascot_Drop">
      <Canvas.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="Flip" ScaleX="1" ScaleY="1"/>
          <TranslateTransform x:Name="Hop" Y="0"/>
          <RotateTransform x:Name="Balanco" Angle="0"/>
        </TransformGroup>
      </Canvas.RenderTransform>
      <Canvas.ContextMenu>
        <ContextMenu Opened="Menu_Aberto">
          <MenuItem Header="Enviar alerta..." FontWeight="SemiBold" Click="EnviarAlerta_Click"/>
          <MenuItem Header="Configurar alertas..." Click="ConfigAlertas_Click"/>
          <Separator/>
          <MenuItem Header="Que horas são?" Click="Hora_Click"/>
          <MenuItem Header="Como está o tempo?" Click="Tempo_Click"/>
          <MenuItem Header="Canhão!" Click="Canhao_Click"/>
          <MenuItem Header="Roleta russa" Click="Roleta_Click"/>
          <MenuItem x:Name="MiMochila" Header="Mochila..." Click="Mochila_Click"/>
          <MenuItem Header="Falar algo" Click="Falar_Click"/>
          <MenuItem x:Name="MiParar" Header="Ficar parado" IsCheckable="True" Click="Parar_Click"/>
          <Separator/>
          <MenuItem x:Name="MiPersonagens" Header="Trocar personagem"/>
          <MenuItem Header="Editor de personagens..." Click="EditorPersonagens_Click"/>
          <MenuItem x:Name="MiGuardas" Header="Trocar guarda-chuva"/>
          <MenuItem Header="Editor de guarda-chuva..." Click="EditorGuarda_Click"/>
          <MenuItem Header="Configurar clima..." Click="ConfigClima_Click"/>
          <Separator/>
          <MenuItem Header="Fechar mascote" Click="Fechar_Click"/>
        </ContextMenu>
      </Canvas.ContextMenu>
    </Canvas>
  </Canvas>
</Window>
