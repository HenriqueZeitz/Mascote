<!-- Nuvem desenhada numa caixa 100x60 (a base da nuvem fica em y=52) -->
<Canvas x:Class="Mascote.Clima.NuvemChuva"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="100" Height="60" IsHitTestVisible="False">
  <Canvas x:Name="Gotas"/>
  <Path x:Name="Raio" Data="M 56,48 L 46,66 L 55,66 L 47,86" Stroke="#FFD600" StrokeThickness="4"
        StrokeLineJoin="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
  <Path x:Name="Corpo" Stroke="#37474F" StrokeThickness="2.5">
    <Path.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CFD8DC" Offset="0"/><GradientStop Color="#78909C" Offset="1"/>
      </LinearGradientBrush>
    </Path.Fill>
    <Path.Data>
      <CombinedGeometry GeometryCombineMode="Union">
        <CombinedGeometry.Geometry1>
          <CombinedGeometry GeometryCombineMode="Union">
            <CombinedGeometry.Geometry1><EllipseGeometry Center="27,36" RadiusX="20" RadiusY="16"/></CombinedGeometry.Geometry1>
            <CombinedGeometry.Geometry2><EllipseGeometry Center="52,26" RadiusX="25" RadiusY="22"/></CombinedGeometry.Geometry2>
          </CombinedGeometry>
        </CombinedGeometry.Geometry1>
        <CombinedGeometry.Geometry2>
          <CombinedGeometry GeometryCombineMode="Union">
            <CombinedGeometry.Geometry1><EllipseGeometry Center="76,36" RadiusX="19" RadiusY="15"/></CombinedGeometry.Geometry1>
            <CombinedGeometry.Geometry2><RectangleGeometry Rect="27,34,49,18" RadiusX="6" RadiusY="6"/></CombinedGeometry.Geometry2>
          </CombinedGeometry>
        </CombinedGeometry.Geometry2>
      </CombinedGeometry>
    </Path.Data>
  </Path>
  <Ellipse Canvas.Left="38" Canvas.Top="10" Width="16" Height="8" Fill="White" Opacity="0.5"/>
</Canvas>
