<!-- Desenho da mochila (caixa 60x64) -->
<Canvas x:Class="Mascote.Mochila.MochilaDesenho"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="60" Height="64" Cursor="Hand" ToolTip="Mochila (clique para abrir)">
  <Path Data="M 17,12 Q 30,-6 43,12" Stroke="#4E342E" StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
  <Rectangle Canvas.Left="6" Canvas.Top="10" Width="48" Height="52" RadiusX="13" RadiusY="13" Fill="#8D6E63" Stroke="#4E342E" StrokeThickness="3"/>
  <Rectangle Canvas.Left="14" Canvas.Top="37" Width="32" Height="19" RadiusX="6" RadiusY="6" Fill="#A1887F" Stroke="#4E342E" StrokeThickness="2.5"/>
  <Line X1="20" Y1="44" X2="40" Y2="44" Stroke="#4E342E" StrokeThickness="2" StrokeDashArray="2 1.5"/>
  <Canvas>
    <Canvas.RenderTransform><RotateTransform x:Name="GiroTampa" Angle="0" CenterX="8" CenterY="22"/></Canvas.RenderTransform>
    <Path Data="M 6,27 Q 6,10 30,10 Q 54,10 54,27 Z" Fill="#6D4C41" Stroke="#4E342E" StrokeThickness="3" StrokeLineJoin="Round"/>
    <Rectangle Canvas.Left="25.5" Canvas.Top="21" Width="9" Height="10" RadiusX="2" RadiusY="2" Fill="#FFCA28" Stroke="#4E342E" StrokeThickness="1.6"/>
  </Canvas>
  <Border x:Name="Contador" Canvas.Left="38" Canvas.Top="-6" MinWidth="22" Height="22" CornerRadius="11" Background="#E53935"
          BorderBrush="White" BorderThickness="2" RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><ScaleTransform x:Name="EscalaContador"/></Border.RenderTransform>
    <TextBlock x:Name="Qtd" Text="0" Foreground="White" FontWeight="Bold" FontSize="11" FontFamily="Segoe UI"
               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
  </Border>
</Canvas>
