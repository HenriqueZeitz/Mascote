<!-- Revólver de desenho animado numa caixa 84x52, cano apontando para a ESQUERDA (boca do cano em x=2, y=16) -->
<Canvas x:Class="Mascote.Roleta.Arma"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="84" Height="52" IsHitTestVisible="False">
  <!-- bandeirinha "BANG!" (sai do cano) -->
  <Canvas Visibility="Collapsed" x:Name="Bandeira">
    <Canvas.RenderTransform><ScaleTransform x:Name="EscalaBandeira" ScaleX="0" ScaleY="1" CenterX="2" CenterY="16"/></Canvas.RenderTransform>
    <Line X1="2" Y1="16" X2="-34" Y2="16" Stroke="#5D4037" StrokeThickness="2.5"/>
    <Border Canvas.Left="-96" Canvas.Top="2" Width="64" Height="28" Background="White" BorderBrush="#B71C1C" BorderThickness="2.5" CornerRadius="3">
      <TextBlock Text="BANG!" FontFamily="Impact, Segoe UI" FontWeight="Bold" FontSize="17" Foreground="#D50000"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
  </Canvas>
  <!-- cano -->
  <Rectangle Canvas.Left="2" Canvas.Top="10" Width="42" Height="12" RadiusX="2" RadiusY="2" Fill="#90A4AE" Stroke="#263238" StrokeThickness="2"/>
  <Rectangle Canvas.Left="4" Canvas.Top="6" Width="5" Height="5" Fill="#263238"/>
  <!-- cabo e armação -->
  <Path Data="M 40,10 L 66,10 Q 72,10 72,16 L 72,22 L 84,46 Q 85,51 79,51 L 66,51 Q 62,51 61,46 L 56,28 L 40,28 Z"
        Fill="#78909C" Stroke="#263238" StrokeThickness="2" StrokeLineJoin="Round"/>
  <Path Data="M 66,24 L 76,46 Q 77,49 74,49 L 68,49 Q 65,49 64,46 L 60,30 Z" Fill="#8D6E63" Stroke="#4E342E" StrokeThickness="1.5"/>
  <!-- guarda-mato e gatilho -->
  <Path Data="M 46,28 Q 46,40 56,40 L 58,34" Stroke="#263238" StrokeThickness="2" Fill="{x:Null}"/>
  <Path Data="M 52,28 Q 51,33 54,36" Stroke="#263238" StrokeThickness="2.2"/>
  <!-- cão -->
  <Path Data="M 66,10 L 72,3 L 75,5 L 70,12" Fill="#455A64" Stroke="#263238" StrokeThickness="1.5" StrokeLineJoin="Round"/>
  <!-- tambor (gira) -->
  <Canvas>
    <Canvas.RenderTransform><RotateTransform x:Name="Tambor" CenterX="54" CenterY="19"/></Canvas.RenderTransform>
    <Ellipse Canvas.Left="42" Canvas.Top="7" Width="24" Height="24" Fill="#B0BEC5" Stroke="#263238" StrokeThickness="2"/>
    <Ellipse Canvas.Left="51" Canvas.Top="9" Width="6" Height="6" Fill="#37474F"/>
    <Ellipse Canvas.Left="58.5" Canvas.Top="13.5" Width="6" Height="6" Fill="#37474F"/>
    <Ellipse Canvas.Left="58.5" Canvas.Top="20" Width="6" Height="6" Fill="#37474F"/>
    <Ellipse Canvas.Left="51" Canvas.Top="24" Width="6" Height="6" Fill="#37474F"/>
    <Ellipse Canvas.Left="43.5" Canvas.Top="20" Width="6" Height="6" Fill="#37474F"/>
    <Ellipse Canvas.Left="43.5" Canvas.Top="13.5" Width="6" Height="6" Fill="#FFC107" Stroke="#8D6E63" StrokeThickness="0.8"/>
    <Ellipse Canvas.Left="52" Canvas.Top="17" Width="4" Height="4" Fill="#263238"/>
  </Canvas>
</Canvas>
