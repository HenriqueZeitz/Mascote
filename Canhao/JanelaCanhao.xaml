<!-- Enquanto mira, esta camada quase invisível cobre a tela para capturar o mouse -->
<Window x:Class="Mascote.Canhao.JanelaCanhao"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize" Cursor="Cross">
  <Canvas x:Name="Palco">
    <Canvas x:Name="Pontos" IsHitTestVisible="False"/>
    <Canvas x:Name="Carreta" IsHitTestVisible="False">
      <!-- carreta de madeira -->
      <Path Data="M -34,24 L -20,-4 L 16,-4 L 30,24 Z" Fill="#8D5524" Stroke="#4E2A0E" StrokeThickness="2.5" StrokeLineJoin="Round"/>
      <!-- cano (desenhado apontando para a direita; gira em volta de 0,0) -->
      <Canvas>
        <Canvas.RenderTransform><RotateTransform x:Name="Giro" Angle="-45"/></Canvas.RenderTransform>
        <Rectangle Canvas.Left="-16" Canvas.Top="-14" Width="80" Height="28" RadiusX="9" RadiusY="9" Stroke="#111" StrokeThickness="2.5">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#78909C" Offset="0"/><GradientStop Color="#37474F" Offset="0.5"/><GradientStop Color="#1C262B" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle Canvas.Left="16" Canvas.Top="-14" Width="6" Height="28" Fill="#263238" Opacity="0.7"/>
        <Rectangle Canvas.Left="58" Canvas.Top="-17" Width="12" Height="34" RadiusX="3" RadiusY="3" Fill="#455A64" Stroke="#111" StrokeThickness="2.5"/>
        <Ellipse Canvas.Left="64" Canvas.Top="-10" Width="7" Height="20" Fill="#111"/>
        <Path x:Name="Fumaca" Data="M 72,0 m -4,0 a 14,12 0 1,0 28,0 a 14,12 0 1,0 -28,0" Fill="#DDD" Stroke="#999" StrokeThickness="1.5" Visibility="Collapsed"/>
      </Canvas>
      <!-- roda -->
      <Ellipse Canvas.Left="-21" Canvas.Top="-6" Width="42" Height="42" Fill="#6D4C41" Stroke="#3E2723" StrokeThickness="3"/>
      <Path Data="M 0,-3 L 0,33 M -18,15 L 18,15 M -12.7,2.3 L 12.7,27.7 M 12.7,2.3 L -12.7,27.7" Stroke="#3E2723" StrokeThickness="2.5"/>
      <Ellipse Canvas.Left="-6" Canvas.Top="9" Width="12" Height="12" Fill="#A1887F" Stroke="#3E2723" StrokeThickness="2"/>
    </Canvas>
    <Border x:Name="Painel" Background="#E6FFFFFF" BorderBrush="#5A3E0A" BorderThickness="1.5" CornerRadius="10" Padding="12,8" Width="300" IsHitTestVisible="False">
      <StackPanel>
        <TextBlock Text="Canhão!" FontWeight="Bold" FontSize="15" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
        <TextBlock Text="Mire com o mouse  ·  segure o botão para carregar  ·  solte para atirar  ·  Esc cancela"
                   FontFamily="Segoe UI" FontSize="11" Foreground="#555" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,6"/>
        <Grid>
          <Border Height="14" CornerRadius="7" Background="#DDD" BorderBrush="#999" BorderThickness="1"/>
          <Border x:Name="Barra" Height="14" CornerRadius="7" HorizontalAlignment="Left" Width="0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#43A047" Offset="0"/><GradientStop Color="#FDD835" Offset="0.5"/><GradientStop Color="#E53935" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Grid>
        <TextBlock x:Name="TxtForca" Text="Força: 50%" FontFamily="Segoe UI" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
      </StackPanel>
    </Border>
  </Canvas>
</Window>
