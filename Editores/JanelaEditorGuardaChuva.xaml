<!-- Editor de Guarda-chuva
     1) Abra um PNG de guarda-chuva  2) Confira onde o personagem segura e o topo (de onde balança)  3) Salve -->
<Window x:Class="Mascote.Editores.JanelaEditorGuardaChuva"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor de Guarda-chuva" Width="1000" Height="700" MinWidth="800" MinHeight="560"
        Background="#F3F3F6" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DrawingBrush x:Key="Xadrez" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H2 V2 H0Z"/>
          <GeometryDrawing Brush="#E4E4EA" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z"/>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
  </Window.Resources>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,4">
      <Button Content="Abrir imagem..." Click="Abrir_Click"/>
      <Button Content="Editar guarda-chuva salvo..." Click="Editar_Click"/>
      <Button Content="Salvar guarda-chuva" FontWeight="SemiBold" Click="Salvar_Click"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="#E6E6EC" Padding="10,6">
      <TextBlock x:Name="Status" TextWrapping="Wrap" Text="Abra um PNG de guarda-chuva para começar."/>
    </Border>
    <Grid Margin="10,4,10,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Xadrez}" BorderBrush="#CCC" BorderThickness="1" Margin="0,0,10,0">
        <Viewbox Stretch="Uniform" Margin="20">
          <Canvas x:Name="Stage" Width="1" Height="1" Background="Transparent" Cursor="Cross" MouseLeftButtonUp="Stage_Clique">
            <Image x:Name="Img" Stretch="Fill"/>
            <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
          </Canvas>
        </Viewbox>
      </Border>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,0">
          <TextBlock Text="Nome do guarda-chuva"/>
          <TextBox x:Name="TxtNome" Margin="0,2,0,10" Padding="3"/>
          <DockPanel>
            <TextBlock x:Name="LblTam" DockPanel.Dock="Right" Text="115%" FontWeight="SemiBold"/>
            <TextBlock Text="Tamanho (largura em relação ao personagem)" TextWrapping="Wrap"/>
          </DockPanel>
          <Slider x:Name="SldTam" Minimum="50" Maximum="250" Value="115" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,4,0,10"
                  ValueChanged="SldTam_Mudou"/>
          <TextBlock Text="Clique no desenho para marcar:" FontWeight="SemiBold"/>
          <RadioButton x:Name="RbMao" IsChecked="True" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="10" Height="10" Fill="#E53935" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="Onde o personagem segura (o cabo)"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="10" Height="10" Fill="#1E88E5" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="Topo (de onde ele balança)"/>
            </StackPanel>
          </RadioButton>
          <TextBlock TextWrapping="Wrap" Foreground="#555" FontSize="12" Margin="0,8,0,0"
                     Text="Os dois pontos são marcados sozinhos (ponta de baixo e ponta de cima). O cabo fica encostado na cabeça do personagem e ele balança pendurado no topo."/>
          <TextBlock Text="Prévia (com o personagem atual)" FontWeight="SemiBold" Margin="0,12,0,2"/>
          <Border Background="{StaticResource Xadrez}" BorderBrush="#CCC" BorderThickness="1" Height="300">
            <Canvas x:Name="Previa" ClipToBounds="True"/>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
