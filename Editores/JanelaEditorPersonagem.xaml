<!-- Editor de Personagens
     1) Abra um PNG com fundo transparente  2) Confira/ajuste os membros detectados  3) Salve -->
<Window x:Class="Mascote.Editores.JanelaEditorPersonagem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor de Personagens" Width="1080" Height="780" MinWidth="840" MinHeight="580"
        Background="#F3F3F6" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DrawingBrush x:Key="Xadrez" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H2 V2 H0Z"/>
          <GeometryDrawing Brush="#E4E4EA" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z"/>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
  </Window.Resources>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,4">
      <Button Content="Abrir imagem..." Click="Abrir_Click"/>
      <Button Content="Editar personagem salvo..." Click="Editar_Click"/>
      <Button Content="Detectar membros de novo" Click="Detectar_Click"/>
      <Button Content="Salvar personagem" FontWeight="SemiBold" Click="Salvar_Click"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="#E6E6EC" Padding="10,6">
      <TextBlock x:Name="Status" TextWrapping="Wrap" Text="Abra um PNG com fundo transparente para começar."/>
    </Border>
    <Grid Margin="10,4,10,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Xadrez}" BorderBrush="#CCC" BorderThickness="1" Margin="0,0,10,0">
        <Viewbox Stretch="Uniform" Margin="20">
          <Canvas x:Name="Stage" Width="1" Height="1" Background="Transparent" Cursor="Cross"
                  MouseLeftButtonDown="Stage_BotaoDesce" MouseMove="Stage_MouseMove" MouseLeftButtonUp="Stage_BotaoSobe"
                  MouseRightButtonUp="Stage_BotaoDireito">
            <Image x:Name="Img" Stretch="Fill"/>
            <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
          </Canvas>
        </Viewbox>
      </Border>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,0">
          <TextBlock Text="Nome do personagem"/>
          <TextBox x:Name="TxtNome" Margin="0,2,0,8" Padding="3"/>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,6,0">
              <TextBlock Text="Altura na tela (px)"/>
              <TextBox x:Name="TxtAltura" Text="72" Margin="0,2,0,0" Padding="3"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Olhando para"/>
              <ComboBox x:Name="CmbOlhando" Margin="0,2,0,0" SelectionChanged="CmbOlhando_Mudou"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="Membros" FontWeight="SemiBold" Margin="0,4,0,2"/>
          <ListBox x:Name="LstPartes" Height="140" SelectionChanged="LstPartes_Mudou"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
            <Button Content="+ Novo membro" Click="Nova_Click"/>
            <Button Content="Remover" Click="Remover_Click"/>
          </StackPanel>
          <TextBlock Text="Formato da área (como você marca no desenho)"/>
          <ComboBox x:Name="CmbForma" Margin="0,2,0,6" SelectionChanged="CmbForma_Mudou"/>
          <StackPanel x:Name="PainelParte" IsEnabled="False">
            <TextBlock Text="Tipo do membro"/>
            <ComboBox x:Name="CmbPapel" Margin="0,2,0,6" SelectionChanged="CmbPapel_Mudou"/>
            <CheckBox x:Name="ChkPreencher" Content="Preencher o buraco que fica atrás" Click="ChkPreencher_Click"/>
            <TextBlock Text="Use em membros desenhados por cima do corpo (asa, olhos, braço na frente da barriga)."
                       FontSize="11" Foreground="#777" TextWrapping="Wrap" Margin="20,0,0,0"/>
          </StackPanel>
          <TextBlock Text="Prévia" FontWeight="SemiBold" Margin="0,12,0,2"/>
          <Border Background="{StaticResource Xadrez}" BorderBrush="#CCC" BorderThickness="1" Height="180">
            <Canvas x:Name="Previa" ClipToBounds="True"/>
          </Border>
          <ComboBox x:Name="CmbEstado" Margin="0,6,0,0"/>
          <TextBlock Text="Frases do personagem" FontWeight="SemiBold" Margin="0,12,0,2"/>
          <TextBox x:Name="TxtFrases" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="3"/>
          <TextBlock Text="Uma por linha. É o que ele fala sozinho de vez em quando e no duplo clique."
                     FontSize="11" Foreground="#777" TextWrapping="Wrap"/>
          <TextBlock TextWrapping="Wrap" Foreground="#555" FontSize="12" Margin="0,10,0,0">
            <Run FontWeight="SemiBold">Como editar</Run><LineBreak/>
            • Clique num membro para selecioná-lo.<LineBreak/>
            • Arraste no desenho para refazer a área do membro selecionado (sem seleção, cria um novo).<LineBreak/>
            • No formato "Contorno livre", arraste contornando o membro: o contorno fecha sozinho quando você solta.<LineBreak/>
            • Botão direito: coloca o ponto de giro (círculo branco) — é onde o membro se prende ao corpo.<LineBreak/>
            • A área pode pegar um pouco do corpo: só entram as partes do desenho que estão quase todas dentro dela.
          </TextBlock>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
