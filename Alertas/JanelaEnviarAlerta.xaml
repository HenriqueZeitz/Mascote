<Window x:Class="Mascote.Alertas.JanelaEnviarAlerta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enviar alerta" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" FontFamily="Segoe UI" FontSize="13">
  <StackPanel Margin="14">
    <TextBlock Text="Mensagem"/>
    <TextBox x:Name="Txt" Height="64" TextWrapping="Wrap" MaxLength="140" Padding="4" Margin="0,4,0,10"/>
    <TextBlock Text="Para"/>
    <Border BorderBrush="#CCC" BorderThickness="1" Padding="8,6" Margin="0,4,0,6">
      <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Lista"/>
      </ScrollViewer>
    </Border>
    <TextBlock x:Name="Info" Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Enviar" Padding="16,4" IsDefault="True" Margin="0,0,8,0" Click="Enviar_Click"/>
      <Button Content="Cancelar" Padding="12,4" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
