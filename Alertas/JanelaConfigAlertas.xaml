<Window x:Class="Mascote.Alertas.JanelaConfigAlertas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar alertas" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" FontFamily="Segoe UI" FontSize="13">
  <StackPanel Margin="14">
    <TextBlock Text="Pasta compartilhada na rede (todos precisam acessar a mesma)"/>
    <DockPanel Margin="0,4,0,10">
      <Button DockPanel.Dock="Right" Content="Procurar..." Padding="10,3" Margin="6,0,0,0" Click="Procurar_Click"/>
      <TextBox x:Name="TxtPasta" Padding="3"/>
    </DockPanel>
    <TextBlock Text="Seu nome (como aparece para os outros)"/>
    <TextBox x:Name="TxtNome" Padding="3" Margin="0,4,0,10" MaxLength="40"/>
    <TextBlock x:Name="Info" Foreground="#B00020" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Salvar" Padding="16,4" IsDefault="True" Margin="0,0,8,0" Click="Salvar_Click"/>
      <Button Content="Cancelar" Padding="12,4" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
